# Loan Prediction System — environment
# Copy to .env and fill in. Never commit .env.
# Read by config/settings.py (backend, pipeline scripts) and
# frontend/utils/api_client.py (Streamlit).

# ── Database (PostgreSQL) ───────────────────────────────────
# Either set the full URL…
DATABASE_URL=postgresql+psycopg2://postgres:your-password@localhost:5432/customer_loan
# …or leave DATABASE_URL unset and set the parts instead:
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=customer_loan
# DB_TYPE=postgresql+psycopg2
# Pool tuning (defaults shown)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_ECHO=False

# ── LLM advisory chatbot ────────────────────────────────────
# Order: HuggingFace if HF_API_TOKEN is set; Claude if it isn't (or the
# HuggingFace call fails) and ANTHROPIC_API_KEY is set; otherwise a
# rule-based report.
# HuggingFace token from huggingface.co/settings/tokens
HF_API_TOKEN=
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Anthropic API key from platform.claude.com (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-key
# CLAUDE_MODEL=claude-haiku-5-5

# ── Frontend → backend ──────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── Training (optional, defaults shown) ─────────────────────
# DEFAULT_CLASSIFIERS=random_forest
# MODEL_SELECTION_METRIC=roc_auc
# MODEL_VERSION=v1.0.0
# TEST_SIZE=0.2
# RANDOM_STATE=42
# CV_FOLDS=5
# MIN_CONFIDENCE_THRESHOLD=0.5
# SIMILARITY_THRESHOLD=0.85
# HASH_ALGORITHM=sha256

# ── Logging (optional, defaults shown) ──────────────────────
# LOG_LEVEL=INFO
# LOG_ROTATION=10 MB
# LOG_RETENTION=30 days
